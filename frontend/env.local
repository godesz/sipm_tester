# Frontend environment variables
# Rename this file to .env.local before use
#
# URL of the FastAPI backend, as seen FROM THE BROWSER.
# - On the PC itself:      http://localhost:8000
# - From laptop on LAN:    http://192.168.x.x:8000   (PC's LAN IP)
# - Via SSH tunnel (home): http://localhost:8000      (same as local)
NEXT_PUBLIC_API_URL=http://localhost:8000
